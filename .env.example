# Domain mode requires DNS plus ports 80/443.
SITE_ADDRESS=:80
PUBLIC_BIND_IP=127.0.0.1
MONGO_URI=
MONGO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MONGO_APP_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# Required for JWT signing: generate a random secret with 32+ UTF-8 bytes.
CRM_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MINIMUM_32_BYTES
# Optional one-time admin provisioning; remove after initial startup.
CRM_BOOTSTRAP_EMAIL=
CRM_BOOTSTRAP_PASSWORD=

# Set to true locally for Swagger UI. Keep false on public deployments.
CRM_OPENAPI_ENABLED=false
